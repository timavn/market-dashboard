{
  "schemaVersion": 1,
  "marketTimeZone": "America/New_York",
    "stages": [
        "received",
        "parsed",
        "validated",
        "indexed"
    ],
    "validationRules": {
        "non_empty": "The recognized publication must retain non-empty searchable content.",
        "primary_risk_ranges": "At least one row must contain a ticker, TREND, LRR, and HRR.",
        "supplemental_risk_ranges": "At least one row must contain a ticker, supplemental TREND, LRR, and HRR.",
        "published_trade_signals": "At least one structured security row must contain the tracker's published Trade signal.",
        "entity_rows": "At least one valid ticker/entity row or structured addition/removal must be retained.",
        "portfolio_rankings": "At least one Portfolio Solutions row must contain a valid ticker and rank.",
        "signal_strength_membership": "At least one valid security must be present in the full Signal Strength membership.",
        "volume_metrics": "Both total-market and exchange metric groups must contain parsed percentage data.",
        "cftc_metrics": "At least one CFTC row must contain a metric name and parsed latest value."
    },
