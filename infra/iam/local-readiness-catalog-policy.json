{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOwnedServiceHeartbeats",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": "arn:aws:dynamodb:us-west-1:915328198276:table/MarketDashboardServiceHeartbeats"
    },
    {
      "Sid": "ReadPredictionCatalogV2",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": "arn:aws:dynamodb:us-west-1:915328198276:table/PredictionMarketCatalogV2"
    },
    {
      "Sid": "ReconcilePredictionCatalogV2",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Condition": {
        "ForAnyValue:StringEquals": {
          "dynamodb:EnclosingOperation": "TransactWriteItems"
        }
      },
      "Resource": "arn:aws:dynamodb:us-west-1:915328198276:table/PredictionMarketCatalogV2"
    },
    {
      "Sid": "ReadPredictionPerformanceLedger",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": "arn:aws:dynamodb:us-west-1:915328198276:table/PredictionMarketPerformanceLedger"
    },
    {
      "Sid": "ReconcilePredictionPerformanceLedger",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:UpdateItem",
        "dynamodb:TransactWriteItems"
      ],
      "Resource": "arn:aws:dynamodb:us-west-1:915328198276:table/PredictionMarketPerformanceLedger"
    },
    {
      "Sid": "ReadCanonicalResearchEvents",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": "arn:aws:dynamodb:us-west-1:915328198276:table/ResearchEventLedgerV2"
    },
    {
      "Sid": "ReadRtaRebuildSources",
      "Effect": "Allow",
      "Action": "dynamodb:Scan",
      "Resource": [
        "arn:aws:dynamodb:us-west-1:915328198276:table/HermesEmailIngestLedger",
        "arn:aws:dynamodb:us-west-1:915328198276:table/HedgeyeDailySnapshot"
      ]
    },
    {
      "Sid": "ReadLatestHedgeyeSnapshots",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": "arn:aws:dynamodb:us-west-1:915328198276:table/HedgeyeDailySnapshot/index/snapshotType-date-meta-index"
    },
    {
      "Sid": "WriteRtaMaterializations",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:us-west-1:915328198276:table/HedgeyeDailySnapshot"
    },
    {
      "Sid": "ReadRtaLegacyArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::market-dashboard-csv-data/hedgeye-email/messages/*"
    },
    {
      "Sid": "ReadMarketStructureSnapshot",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:us-west-1:915328198276:table/HedgeyeDailySnapshot"
    },
    {
      "Sid": "ReadMarketStructureAssets",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::market-dashboard-csv-data/hedgeye-email/assets/market-structure/*"
    },
    {
      "Sid": "WriteManualInflationNowcastArtifacts",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::market-dashboard-csv-data/hedgeye-email/messages/manual-inflation-nowcast/*"
    },
    {
      "Sid": "ReadPortfolioResearchIntelligence",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-west-1:915328198276:table/HedgeyeDailySnapshot",
        "arn:aws:dynamodb:us-west-1:915328198276:table/HedgeyeDailySnapshot/index/snapshotType-date-meta-index",
        "arn:aws:dynamodb:us-west-1:915328198276:table/ResearchEntityEventsV1",
        "arn:aws:dynamodb:us-west-1:915328198276:table/ResearchEntityEventsV1/index/marketDate-index",
        "arn:aws:dynamodb:us-west-1:915328198276:table/ResearchProductManifestsV1"
      ]
    },
    {
      "Sid": "ReadExpectedRiskRangePublication",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-west-1:915328198276:table/RiskRangePublicationManifestsV2",
        "arn:aws:dynamodb:us-west-1:915328198276:table/HedgeyeRiskRanges"
      ]
    },
    {
      "Sid": "ReadLambdaDiagnostics",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricStatistics",
      "Resource": "*"
    }
  ]
}
