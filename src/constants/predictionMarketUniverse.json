  "setupRule": {
    "long": "Trend and Trade both Bullish and price in the bottom third of the Risk Range.",
    "short": "Trend and Trade both Bearish and price in the top third of the Risk Range.",
    "bottomThird": 0.3333,
    "topThird": 0.6667,
    "outsideRange": "no setup"
  },
  "sizing": {
    "status": "active",
    "accountBasis": "kalshi",
    "basePct": 3,
    "minPct": 2.5,
    "maxPct": 5.5,
    "roundPct": 0.5,
    "weights": {
      "usd": 1,
      "tick": 0.5,
      "volume": 0.5,
      "zScore": 0.5
    },
    "zScoreFull": 2,
    "usdCorrelationWindow": "d30",
    "usdCorrelationFull": 0.5,
    "volExpansionPct": 10,
    "lines": {
      "maxAsk": 0.5,
      "targetFrom": 0.5,
      "targetTo": 1,
      "maxMoves": 1.5,
      "maxLines": 4
    },
    "maxSpread": 0.05,
    "feeRate": 0.07,
    "markets": [
      "gold",
      "silver",
      "copper",
      "wti",
      "brent",
      "bitcoin",
      "ethereum",
      "sp500",
      "nasdaq100"
    ],
    "note": "A setup starts at basePct. The dollar adds its weight when its Trend supports the side through the 30D correlation (scaled up to usdCorrelationFull); Tick adds its weight when it agrees and subtracts it when it opposes; a supports or confirms volume signal and a Z-score stretched against the side add theirs. Lines are bought in the setup's direction at maxAsk or less, within maxMoves expected moves (Kalshi's own odds: 31¢ is half a move away, 16¢ one, 7¢ one and a half) and never past the far end of the Risk Range. The position is split evenly across the target lines (targetFrom to targetTo moves); lines beyond targetTo join only when the volatility gauge is in its High band or up more than volExpansionPct in a week; nearer lines take only what those cannot. Each market gets a ticket for its daily event and, where one is listed, its weekly event."
  },
  "lineMonitor": {
    "closingHours": 2,
    "minDepthDollars": 50,
    "bookLines": 15,
    "expirySharePct": 50,
    "sectionCapPct": null,
    "bookCapPct": null,
    "note": "Rows shade short (red) when Trade and Trend are both Bearish and price is in the top third of the Risk Range, long (green) when both are Bullish in the bottom third; this is the board's setup rule, and it decides which side of a market's lines is the one to buy. Each market's bet is its sized % of the Kalshi account (the sizing's basePct when not sized); the order books of its bookLines lines nearest even odds are read and the bet is walked through each side's asks, so the price shown is the average the whole bet fills at, and a side that cannot take the whole bet is illiquid. Without books (or an account read) a side is illiquid with less than minDepthDollars resting at its top ask. sectionCapPct and bookCapPct are % of the Kalshi account and stay null until sizing sets them; null raises no flag. heldSeries on a market maps positions in other Kalshi series (weeklies) to that market."
  },
