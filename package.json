{
  "name": "market-dashboard",
  "version": "1.0.0",
  "description": "Financial market dashboard with portfolio analytics and real-time data",
  "private": true,
  "proxy": "http://localhost:3001",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.908.0",
    "@aws-sdk/s3-request-presigner": "^3.908.0",
    "@heroicons/react": "^2.2.0",
    "@tremor/react": "^3.18.7",
    "autoprefixer": "^10.4.21",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "framer-motion": "^12.26.2",
    "lodash": "^4.17.21",
    "lucide-react": "^0.294.0",
    "postcss": "8.4.49",
    "quill": "^2.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-quill": "^2.0.0",
    "react-scripts": "5.0.1",
    "react-sparklines": "^1.7.0",
    "read-excel-file": "^8.0.3",
    "recharts": "^2.8.0",
    "tailwindcss": "^3.4.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.1.0"
  },
  "overrides": {
    "browserslist": "4.25.4",
    "postcss": "8.4.49"
  },
  "scripts": {
    "start": "node scripts/dev-stack/cli.js start",
    "build": "craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "dev": "node scripts/dev-stack/cli.js start",
    "dev:ui": "cross-env PORT=3000 CI=true BROWSER=none GENERATE_SOURCEMAP=false TSC_COMPILE_ON_ERROR=true BROWSERSLIST_IGNORE_OLD_DATA=true NODE_OPTIONS=\"--max-old-space-size=3072 --require ./scripts/cra-dev-require-hook.js\" craco start",
    "dev:api": "cross-env NODE_ENV=development node server.js",
    "dev:sidecar": "bash scripts/ibkr_sidecar/start.sh",
    "dev:sidecar:rebuild": "bash scripts/ibkr_sidecar/rebuild_venv.sh",
    "dev:status": "node scripts/dev-stack/cli.js status",
    "dev:stop": "node scripts/dev-stack/cli.js stop",
    "dev:restart": "node scripts/dev-stack/cli.js restart",
    "dev:doctor": "node scripts/dev-stack/cli.js doctor",
    "dev:ibkr": "node scripts/dev-stack/cli.js start",
    "morning": "node scripts/dev-stack/cli.js morning",
    "morning:check": "node scripts/dev-stack/cli.js morning --check-only",
    "test:morning": "node --test scripts/dev-stack/cli.test.js",
    "test:ops": "node --test scripts/dev-stack/cli.test.js scripts/ops/*.test.js",
    "ops:launchagent:install": "bash scripts/ops/install_launchagent.sh",
    "test:hermes-bridge": "node --test scripts/ops/hermes_snapshot_bridge.test.js",
    "collect:market-structure": "node scripts/collect_market_structure_daily.js",
    "report:market-structure": "node scripts/collect_market_structure_daily.js --report-only",
    "collect:etfpro": "node scripts/collect_etfpro_daily.js",
    "research:rta:checkpoint": "node scripts/capture_rta_checkpoint.js",
    "research:rta:rebuild": "node scripts/rebuild_rta_materializations.js",
    "rebuild:rta": "node scripts/rebuild_rta_materializations.js",
    "ibkr-sidecar": "bash scripts/ibkr_sidecar/start.sh",
    "ibkr-sidecar:check": "bash scripts/ibkr_sidecar/check_gateway.sh",
    "ibkr-sidecar:discover": "curl -sf -X POST http://localhost:3001/api/prediction-markets/discover/ibkr -H 'Content-Type: application/json' -d '{}' | python3 -m json.tool",
    "ibkr-sidecar:wait-discover": "bash scripts/ibkr_sidecar/wait_and_discover.sh",
    "verify:ibkr": "bash scripts/verify_ibkr_stack.sh",
    "verify:ibkr-stream": "bash scripts/verify_ibkr_stream.sh",
    "verify:ibkr-providers": "bash scripts/verify_ibkr_providers.sh",
    "verify:cpi-discovery": "node scripts/verify_cpi_discovery_api.js",
    "verify:workflow": "node scripts/verify_dashboard_workflow.js",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write src/**/*.{js,jsx,json,css,md}"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
