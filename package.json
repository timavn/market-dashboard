    "eslint-plugin-testing-library": "^6.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "^3.1.0",
    "vite": "8.2.2"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "scripts": {
    "research:quad-ranks": "node scripts/research-quad-ranks.cjs",
    "start": "node scripts/dev-stack/cli.js start",
    "build": "vite build",
    "test": "jest",
    "dev": "node scripts/dev-stack/cli.js start",
    "dev:ui": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "dev:api": "cross-env NODE_ENV=development node server.js",
    "dev:sidecar": "bash scripts/ibkr_sidecar/start.sh",
    "dev:sidecar:rebuild": "bash scripts/ibkr_sidecar/rebuild_venv.sh",
    "dev:analyst:setup": "bash scripts/analyst/setup_profile.sh",
    "dev:analyst:sidecar": "bash scripts/analyst_sidecar/start.sh",
    "dev:analyst:sidecar:rebuild": "bash scripts/analyst_sidecar/rebuild_venv.sh",
    "dev:analyst:hermes": "bash scripts/analyst/start_hermes.sh",
    "verify:analyst:contract": "node scripts/analyst/check_hermes_contract.mjs",
    "dev:sidecar:restart": "node scripts/dev-stack/cli.js restart-sidecar",
    "dev:status": "node scripts/dev-stack/cli.js status",
    "dev:stop": "node scripts/dev-stack/cli.js stop",
    "dev:restart": "node scripts/dev-stack/cli.js restart",
    "dev:doctor": "node scripts/dev-stack/cli.js doctor",
    "dev:ibkr": "node scripts/dev-stack/cli.js start",
    "morning": "node scripts/dev-stack/cli.js morning",
    "morning:check": "node scripts/dev-stack/cli.js morning --check-only",
    "report:prediction-morning": "node scripts/prediction_market_morning_report.mjs",
    "prediction-pnl:backfill": "node scripts/prediction_pnl_backfill.cjs",
    "test:prediction-morning": "node --test scripts/prediction_market_morning_report.test.mjs",
    "auth:status": "node scripts/dev-stack/cli.js auth-status",
    "auth:admin:refresh": "node scripts/dev-stack/cli.js auth-admin-login",
    "test:morning": "node --test scripts/dev-stack/cli.test.js",
    "test:ops": "node --test scripts/dev-stack/cli.test.js scripts/ops/*.test.js",
    "ops:launchagent:install": "bash scripts/ops/install_launchagent.sh",
    "ops:analyst:local": "python3 scripts/ops/analyst_consolidation_local.py",
    "ops:controller": "node scripts/ops/hermes_reliability_controller.js",
    "test:hermes-controller": "node --test scripts/ops/hermes_reliability_controller.test.js",
    "test:hermes-bridge": "node --test scripts/ops/hermes_snapshot_bridge.test.js",
    "test:analyst:python": "node scripts/testing/run-python.cjs analyst",
    "test:analyst:node": "node --test scripts/dev-stack/analyst.test.js src/routes/analyst.test.cjs src/services/analyst/analystGatewayProxy.test.cjs src/services/analyst/analystPolicy.test.cjs src/services/analyst/analystPortfolioReference.test.cjs src/services/analyst/analystPredictions.test.cjs src/services/analyst/analystWorkspace.test.cjs src/services/analyst/analystReviewSources.test.cjs src/services/analyst/analystManualVerification.test.cjs src/services/analyst/analystManualEvidence.test.cjs src/services/analyst/analystDaily.test.cjs src/services/analyst/analystRunTimeline.test.cjs src/services/analyst/analystReviewSourcePresentation.test.cjs src/services/analyst/analystAttention.test.cjs src/routes/systemReadiness.test.cjs",
    "test:analyst:ui": "cross-env CI=true jest --runInBand --watchAll=false src/components/Dashboard/AnalystPanel.test.jsx src/services/analyst/analystClient.test.js src/components/Dashboard/AnalystWorkspace.test.jsx src/components/Dashboard/AnalystMessage.test.jsx src/components/Dashboard/AnalystReviewSources.test.jsx src/hooks/useAnalystReviewSources.test.js src/components/Dashboard/AnalystPortfolioBrief.test.jsx src/utils/portfolioReviewRules.test.js src/utils/portfolioReviewOutlook.test.js src/components/Dashboard/AnalystDailyRollup.test.jsx src/components/Dashboard/DashboardTopNavigation.test.jsx src/services/providers/__tests__/ibkrPortfolioDataProvider.test.js src/services/systemReadinessService.test.js",
    "test:analyst": "npm run test:analyst:python && npm run test:analyst:node && npm run test:analyst:ui",
    "verify:analyst:consolidation": "python3 infra/scripts/verify_analyst_consolidation.py",
    "collect:market-structure": "node scripts/collect_market_structure_daily.js",
    "report:market-structure": "node scripts/collect_market_structure_daily.js --report-only",
    "collect:etfpro": "node scripts/collect_etfpro_daily.js",
    "research:etfpro:checkpoint": "node scripts/capture_etfpro_checkpoint.js",
    "research:rta:checkpoint": "node scripts/capture_rta_checkpoint.js",
    "research:rta:rebuild": "node scripts/rebuild_rta_materializations.js",
    "research:intelligence:replay": "python3 infra/scripts/replay_security_intelligence.py",
    "rebuild:rta": "node scripts/rebuild_rta_materializations.js",
    "ibkr-sidecar": "bash scripts/ibkr_sidecar/start.sh",
    "ibkr-sidecar:check": "bash scripts/ibkr_sidecar/check_gateway.sh",
    "ibkr-sidecar:discover": "curl -sf -X POST http://localhost:3001/api/prediction-markets/discover/ibkr -H 'Content-Type: application/json' -d '{}' | python3 -m json.tool",
    "ibkr-sidecar:wait-discover": "bash scripts/ibkr_sidecar/wait_and_discover.sh",
    "verify:ibkr": "bash scripts/verify_ibkr_stack.sh",
    "verify:ibkr-stream": "bash scripts/verify_ibkr_stream.sh",
    "verify:ibkr-providers": "bash scripts/verify_ibkr_providers.sh",
    "lint": "eslint src server.js vite.config.mjs scripts/build scripts/testing scripts/dev-stack scripts/ops --ext .js,.jsx,.cjs,.mjs",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write src/**/*.{js,jsx,json,css,md}",
    "test:node": "node scripts/testing/run-node-tests.cjs",
    "verify:local": "node scripts/testing/verify.cjs local"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.23.0 <23",
    "npm": ">=10 <11"
  }
}
