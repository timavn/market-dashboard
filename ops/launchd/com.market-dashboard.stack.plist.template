<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.market-dashboard.stack</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>__REPO_PATH__/scripts/dev-stack/cli.js</string>
    <string>monitor</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_PATH__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Standard</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH_VALUE__</string>
    <key>MARKET_DASHBOARD_LAUNCHD_LABEL</key>
    <string>com.market-dashboard.stack</string>
    <key>LEGACY_HERMES_MODE</key>
    <string>__LEGACY_HERMES_MODE__</string>
    <key>HERMES_BRIDGE_AWS_PROFILE</key>
    <string>__HERMES_BRIDGE_AWS_PROFILE__</string>
    <key>HERMES_BRIDGE_ENABLED</key>
    <string>__HERMES_BRIDGE_ENABLED__</string>
    <key>HERMES_OPERATIONS_BRIDGE_ENABLED</key>
    <string>__HERMES_OPERATIONS_BRIDGE_ENABLED__</string>
    <key>HERMES_PORTFOLIO_BRIDGE_ENABLED</key>
    <string>__HERMES_PORTFOLIO_BRIDGE_ENABLED__</string>
    <key>READINESS_CONTROLLER_MODE</key>
    <string>__HERMES_CONTROLLER_MODE__</string>
    <key>READINESS_CONTROLLER_ENABLED_ACTIONS</key>
    <string>__HERMES_CONTROLLER_ENABLED_ACTIONS__</string>
    <key>MARKET_DASHBOARD_LOCAL_NOTIFICATIONS</key>
    <string>__LOCAL_NOTIFICATIONS__</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_PATH__/launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_PATH__/launchd.stderr.log</string>
</dict>
</plist>
