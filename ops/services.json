  "repairActions": [
    {
      "id": "start-local-stack",
      "label": "Start missing repo-owned dashboard services",
      "description": "Starts the local supervisor, which adopts only recognized repository processes and refuses unknown port owners.",
      "executor": "dev-stack-start",
      "command": "npm start",
      "automatic": true,
      "loopbackOnly": true,
      "controllerExecutor": "loopback-readiness-api",
      "authority": "automatic",
      "triggeringErrorCodes": [
        "DASHBOARD_UI_UNREACHABLE",
        "DASHBOARD_SUPERVISOR_UNVERIFIED"
      ],
      "scope": "repo-processes",
      "riskClass": "low",
      "prerequisites": [],
      "verificationChecks": ["dashboard.ui", "dashboard.supervisor"],
      "settleTimeoutMs": 30000,
      "cooldownMs": 600000,
      "attemptWindowMs": 3600000,
      "maxAttempts": 2,
      "circuitDurationMs": 3600000,
      "escalationOwner": "local-operations"
    },
    {
      "id": "restart-local-stack",
      "label": "Restart the repo-owned dashboard stack",
      "description": "Restarts only processes whose command and working directory match this repository.",
      "executor": "dev-stack-restart",
      "command": "npm run dev:restart -- --detach",
      "automatic": true,
      "loopbackOnly": true,
      "controllerExecutor": "loopback-readiness-api",
      "authority": "automatic",
      "triggeringErrorCodes": [
        "DASHBOARD_CODE_VERSION_DRIFT",
        "DASHBOARD_SUPERVISOR_CODE_DRIFT",
        "DASHBOARD_RUNTIME_MISMATCH",
        "HERMES_BRIDGE_DISABLED_PROCESS_PRESENT",
        "HERMES_BRIDGE_DISABLED_STATE_UNVERIFIED"
      ],
      "scope": "repo-processes",
      "riskClass": "low",
      "prerequisites": [
        {
          "checkId": "dashboard.supervisor",
          "statuses": ["pass", "warn"],
          "allowedErrorCodes": [null, "DASHBOARD_SUPERVISOR_CODE_DRIFT"],
          "maxAgeMs": 180000
        }
      ],
      "deferrals": [
        {
          "checkId": "analyst.activity",
          "maxAgeMs": 60000,
          "unverifiedMaxDeferralMs": 1800000,
          "errorCodes": ["DASHBOARD_CODE_VERSION_DRIFT", "DASHBOARD_SUPERVISOR_CODE_DRIFT"]
        }
      ],
      "verificationChecks": ["dashboard.supervisor"],
      "settleTimeoutMs": 45000,
      "cooldownMs": 600000,
      "attemptWindowMs": 3600000,
      "maxAttempts": 2,
      "circuitDurationMs": 3600000,
      "escalationOwner": "local-operations"
    },
    {
      "id": "restart-ibkr-sidecar",
      "label": "Restart the repo-owned IBKR sidecar",
      "description": "Signals only the exact repo-owned port-8765 sidecar and leaves the dashboard, controller, bridge, API, UI, and Java IB Gateway untouched.",
      "executor": "dev-stack-sidecar-restart",
      "command": "npm run dev:sidecar:restart",
      "automatic": true,
      "loopbackOnly": true,
      "controllerExecutor": "loopback-readiness-api",
      "authority": "automatic",
      "triggeringErrorCodes": [
        "IBKR_GATEWAY_API_UNRESPONSIVE",
        "IBKR_POSITIONS_CLIENT_UNAVAILABLE",
        "IBKR_POSITIONS_REQUEST_TIMEOUT",
        "IBKR_SOCKET_VERIFICATION_TIMEOUT",
        "IBKR_BALANCE_REQUEST_TIMEOUT",
        "IBKR_LIVE_SESSION_STALE",
        "IBKR_LIVE_SESSION_UNAVAILABLE",
        "IBKR_LIVE_SESSION_UNVERIFIED",
        "IBKR_SIDECAR_UNREACHABLE",
        "IBKR_SIDECAR_DUPLICATES"
      ],
      "triggeringCheckIds": ["local-sidecar", "ibkr.sidecar", "ibkr.gateway", "ibkr.portfolio"],
      "scope": "repo-processes",
      "riskClass": "low",
      "prerequisites": [
        {
          "checkId": "dashboard.supervisor",
          "statuses": ["pass", "warn"],
          "maxAgeMs": 180000
        }
      ],
      "verificationChecks": [
        "ibkr.sidecar",
        "ibkr.gateway",
        "ibkr.accounts",
        "ibkr.portfolio"
      ],
      "settleTimeoutMs": 60000,
      "cooldownMs": 120000,
      "attemptWindowMs": 3600000,
      "maxAttempts": 2,
      "circuitDurationMs": 3600000,
      "escalationOwner": "brokerage-operations"
    },
    {
      "id": "rebuild-sidecar-runtime",
      "label": "Rebuild the repo-owned sidecar runtime",
      "description": "Recreates the sidecar virtual environment from the active workspace, then restarts only the repo-owned local stack.",
      "executor": "sidecar-runtime-rebuild",
      "command": "npm run dev:sidecar:rebuild && npm run dev:restart -- --detach",
      "automatic": true,
      "loopbackOnly": true,
      "controllerExecutor": "loopback-readiness-api",
      "authority": "automatic",
      "triggeringErrorCodes": [
        "RUNTIME_PROVENANCE_MISSING",
        "RUNTIME_PROVENANCE_UNAVAILABLE"
      ],
      "scope": "sidecar-runtime",
      "riskClass": "low",
      "prerequisites": [
        {
          "checkId": "dashboard.supervisor",
          "statuses": ["pass"],
          "maxAgeMs": 180000
        }
      ],
      "verificationChecks": ["ibkr.sidecar", "ibkr.runtime"],
      "settleTimeoutMs": 120000,
      "cooldownMs": 900000,
      "attemptWindowMs": 3600000,
      "maxAttempts": 2,
      "circuitDurationMs": 3600000,
      "escalationOwner": "local-operations"
    },
    {
      "id": "retry-gmail-poll",
      "label": "Retry the configured Gmail poll",
      "description": "Asynchronously invokes the configured Gmail ingestion Lambda with the fixed incremental-poll event. It does not modify OAuth credentials.",
      "executor": "gmail-poll-retry",
      "command": "Retry the configured Gmail incremental poll",
      "automatic": true,
      "loopbackOnly": true,
      "controllerExecutor": "loopback-readiness-api",
      "authority": "automatic",
      "triggeringErrorCodes": [
        "GMAIL_PROVIDER_UNAVAILABLE",
        "GMAIL_RATE_LIMITED",
        "GMAIL_TRANSIENT_ERROR"
      ],
      "scope": "gmail-incremental-poll",
      "riskClass": "low",
      "prerequisites": [
        {
          "checkId": "gmail.ingestion",
          "statuses": ["warn", "fail"],
          "maxAgeMs": 1200000,
          "provenanceEquals": {
            "heartbeatSource": "aws-lambda",
            "triggerSource": "aws-scheduler",
            "scheduleId": "market-dashboard-gmail-v2-every-15m"
          }
        }
      ],
      "verificationChecks": ["gmail.ingestion"],
      "settleTimeoutMs": 120000,
      "cooldownMs": 900000,
      "attemptWindowMs": 3600000,
      "maxAttempts": 2,
      "circuitDurationMs": 3600000,
      "escalationOwner": "automation-operations"
    },
    {
      "id": "rebuild-research-projections",
      "label": "Rebuild deterministic RTA projections",
      "description": "Replays the immutable Gmail ledger into the rebuildable RTA projection table for the fixed 90-day window.",
      "executor": "research-projections-rebuild",
      "command": "npm run rebuild:rta -- --apply --window-days=90 --json",
      "automatic": true,
      "loopbackOnly": true,
      "controllerExecutor": "loopback-readiness-api",
