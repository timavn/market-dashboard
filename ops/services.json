    {
      "id": "ibkr-connectivity",
      "label": "IBKR connectivity",
      "text": "Rebuild or restart the repo-owned sidecar automatically. IB Gateway login and API socket authorization remain manual security actions."
    },
    {
      "id": "automation-schedules",
      "label": "Hermes schedules",
      "text": "Verify the named AWS Scheduler job and typed service heartbeat. Manual invocations and shared Lambda metrics do not prove schedule health."
    },
    {
      "id": "gmail-ingestion",
      "label": "Gmail ingestion",
      "text": "Require a fresh typed poll heartbeat. OAuth grants are manual; incremental poll retries are safe only after authorization is valid."
    },
    {
      "id": "research-projections",
      "label": "Research projections",
      "text": "Replay immutable artifacts and events into deterministic projections, reconcile against authoritative checkpoints, and fail closed on conflicts."
    }
  ],
