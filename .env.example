# API Configuration — MarketDataService uses REACT_APP_BACKEND_URL (see src/services/api/marketDataService.js)
REACT_APP_BACKEND_URL=http://localhost:3001
REACT_APP_API_BASE_URL=http://localhost:3001

# Restart `npm run server` after pulling backend changes so Currencies 30D/90D columns receive thirtyDayChangePct/ninetyDayChangePct.

# External API Keys (replace with your actual keys)
REACT_APP_ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
REACT_APP_FINNHUB_KEY=your_finnhub_key_here
REACT_APP_POLYGON_KEY=your_polygon_key_here

# WebSocket Configuration
REACT_APP_WS_URL=ws://localhost:3001

# Environment
NODE_ENV=development

# Prediction markets ingestion (server-side; restart npm run server after changes)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# KALSHI_PRIVATE_KEY_PEM=          # alternative to file path (Lambda / Secrets Manager)
KALSHI_API_BASE_URL=https://external-api.kalshi.com/trade-api/v2
IBKR_SIDECAR_URL=http://localhost:8765
IBKR_SIDECAR_TIMEOUT_MS=5000
IBKR_REFRESH_TIMEOUT_MS=5000
IBKR_CPI_REFRESH_TIMEOUT_MS=30000
IBKR_DISCOVER_TIMEOUT_MS=60000
IBKR_CPI_DISCOVER_TIMEOUT_MS=20000
PM_CPI_RECONCILER_ENABLED=true
PM_CPI_RECONCILE_POLL_MS=300000
PM_CPI_PREMARKET_RECONCILE_MS=900000
PM_CPI_RECONCILE_TIME_ZONE=America/New_York
REACT_APP_IBKR_REFRESH_TIMEOUT_MS=60000
REACT_APP_IBKR_DISCOVER_TIMEOUT_MS=30000
IB_GATEWAY_HOST=127.0.0.1
# Live IB Gateway: 4001. Paper IB Gateway: 4002. TWS live/paper: 7496/7497.
# start.sh auto-detects an open port if IB_GATEWAY_PORT is unset or unreachable.
IB_GATEWAY_PORT=4002
IB_GATEWAY_CLIENT_ID=17
IBKR_INGEST_ENABLED=true
IBKR_MARKET_DATA_ENABLED=true
IBKR_PORTFOLIO_ENABLED=true
IBKR_ACCOUNT_ID=
IBKR_QUOTE_CACHE_TTL_MS=3000
IBKR_QUOTE_STALE_SEC=60
IBKR_MAX_QUOTE_BATCH=50
# Streaming (persistent Gateway connection + SSE → Express → WebSocket)
IBKR_PERSISTENT_CONNECT=true
IBKR_STREAM_ENABLED=true
IBKR_MAX_STREAM_SUBS=100
IBKR_STREAM_DEBOUNCE_MS=150
IBKR_RECONNECT_BASE_MS=1000
IBKR_ACCOUNT_SUMMARY_REFRESH_SEC=30
IBKR_WS_QUOTE_THROTTLE_MS=250
IBKR_EXPOSE_OPEN_ORDERS=false
REACT_APP_IBKR_STREAM_ENABLED=true
IBKR_PREFER_UPLOAD=false
IBKR_DEV_SMOKE=false

# IBKR Flex Web Service (server-side end-of-day reconciliation only)
IBKR_FLEX_ENABLED=false
IBKR_FLEX_TOKEN=
IBKR_FLEX_ACTIVITY_QUERY_ID=
IBKR_FLEX_BASE_URL=https://ndcdyn.interactivebrokers.com/AccountManagement/FlexWebService
IBKR_FLEX_TARGET_CASH_BUFFER_PCT=0
# IBKR_FLEX_DATA_DIR=data/ibkr-flex

FINANCIAL_PREDICTION_EVENTS_TABLE=FinancialPredictionEvents
PREDICTION_MARKET_CATALOG_V2_TABLE=PredictionMarketCatalogV2
IBKR_LIVE_SESSION_VERIFY_TIMEOUT_SEC=2.5
BLS_API_KEY=
BEA_API_KEY=
FRED_API_KEY=
# Hermes worker orchestration (server-side; restart npm run server after changes)
HERMES_AGENT_RUNS_TABLE=HermesAgentRuns
HERMES_ALERTS_TABLE=HermesAlerts
HERMES_QUANT_ANALYST_FUNCTION=market-dashboard-hermes-worker-v2
HERMES_QUANT_DEVELOPER_FUNCTION=market-dashboard-hermes-worker-v2
HERMES_SECURITY_FUNCTION=market-dashboard-hermes-worker-v2
# Hermes Gmail ingestion. Gmail filter should apply label/folder "Hedgeye" to Hedgeye mail.
GMAIL_OAUTH_SECRET_NAME=hermes/gmail/oauth
HERMES_GMAIL_ACCOUNT=timsmithaviation@gmail.com
HERMES_GMAIL_QUERY=label:Hedgeye newer_than:365d
HERMES_GMAIL_INGESTOR_FUNCTION=market-dashboard-gmail-ingestor-v2
HERMES_GMAIL_SCHEDULE_ID=market-dashboard-gmail-v2-every-15m
GMAIL_HEARTBEAT_MAX_AGE_MINUTES=45
# Outbound-only local-to-AWS bridge. It opens no listener and publishes only
# verified live IBKR positions plus readiness metadata.
HERMES_INPUT_SNAPSHOT_TABLE=HermesInputSnapshots
SERVICE_HEARTBEAT_TABLE=MarketDashboardServiceHeartbeats
HERMES_BRIDGE_HOST_ID=tim-market-dashboard
HERMES_BRIDGE_INTERVAL_MS=60000
HERMES_BRIDGE_HEARTBEAT_MAX_AGE_MS=180000
HERMES_BRIDGE_REQUEST_TIMEOUT_MS=20000
HERMES_BRIDGE_MAX_INPUT_AGE_MS=180000
HERMES_BRIDGE_TTL_DAYS=30
# Short single-flight cache for the operational readiness report.
SYSTEM_READINESS_CACHE_MS=15000
# AWS_REGION=us-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
