# API Configuration — MarketDataService uses REACT_APP_BACKEND_URL (see src/services/api/marketDataService.js)
REACT_APP_BACKEND_URL=http://localhost:3001
REACT_APP_API_BASE_URL=http://localhost:3001

# Restart `npm run server` after pulling backend changes so Currencies 30D/90D columns receive thirtyDayChangePct/ninetyDayChangePct.

# External API Keys (replace with your actual keys)
REACT_APP_ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
REACT_APP_FINNHUB_KEY=your_finnhub_key_here
REACT_APP_POLYGON_KEY=your_polygon_key_here

# WebSocket Configuration
REACT_APP_WS_URL=ws://localhost:3001

# Environment
NODE_ENV=development

# Kalshi API for the Analyst Predictive markets setup board (server-side)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# KALSHI_PRIVATE_KEY_PEM=          # alternative to file path (Lambda / Secrets Manager)
KALSHI_API_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# IBKR sidecar and IB Gateway
IBKR_SIDECAR_URL=http://localhost:8765
IBKR_SIDECAR_TIMEOUT_MS=5000
# Exact IBKR account expected by account-coverage checks
# (falls back to IBKR_ACCOUNT_ID, then IBKR_FLEX_EXPECTED_ACCOUNT_ID).
PREDICTION_MARKET_PERFORMANCE_ACCOUNT_ID=
IB_GATEWAY_HOST=127.0.0.1
# Live IB Gateway: 4001. Paper IB Gateway: 4002. TWS live/paper: 7496/7497.
# start.sh auto-detects an open port if IB_GATEWAY_PORT is unset or unreachable.
IB_GATEWAY_PORT=4002
IB_GATEWAY_CLIENT_ID=17
IBKR_MARKET_DATA_ENABLED=true
IBKR_PORTFOLIO_ENABLED=true
IBKR_ACCOUNT_ID=
IBKR_QUOTE_CACHE_TTL_MS=3000
IBKR_QUOTE_STALE_SEC=60
IBKR_QUOTE_WAIT_SEC=2.5
IBKR_QUOTE_MAX_CONCURRENCY=6
IBKR_QUOTE_REQUEST_TIMEOUT_MS=10000
IBKR_MAX_QUOTE_BATCH=50
# Streaming (persistent Gateway connection + SSE → Express → WebSocket)
IBKR_PERSISTENT_CONNECT=true
IBKR_PRIMARY_SOCKET_HEARTBEAT_MAX_AGE_SEC=15
IBKR_STREAM_ENABLED=true
IBKR_MAX_STREAM_SUBS=100
IBKR_STREAM_DEBOUNCE_MS=150
IBKR_RECONNECT_BASE_MS=1000
IBKR_ACCOUNT_SUMMARY_REFRESH_SEC=30
IBKR_WS_QUOTE_THROTTLE_MS=250
IBKR_EXPOSE_OPEN_ORDERS=false
REACT_APP_IBKR_STREAM_ENABLED=true
# Gated migration for the canonical per-security research projection.
REACT_APP_SECURITY_INTELLIGENCE_V2_ENABLED=false
IBKR_PREFER_UPLOAD=false
IBKR_DEV_SMOKE=false

# Exposure Lab: complete Hedgeye archive discovery plus adjusted-return factor risk.
HEDGEYE_DAILY_SNAPSHOT_TABLE=HedgeyeDailySnapshot
HEDGEYE_RISK_RANGES_TABLE=HedgeyeRiskRanges
EXPOSURE_LAB_SECURITY_MASTER_TABLE=ExposureLabSecurityMasterV1
EXPOSURE_LAB_SECURITY_MASTER_INDEX=recordType-sortKey-index
EXPOSURE_LAB_UNIVERSE_CACHE_TTL_MS=900000
EXPOSURE_LAB_MAX_POSITION_SYMBOLS=75
EXPOSURE_LAB_HISTORY_CALENDAR_DAYS=550
SECURITY_RISK_METRICS_CACHE_MAX_ENTRIES=160

# IBKR Flex Web Service (server-side end-of-day reconciliation only)
IBKR_FLEX_ENABLED=false
IBKR_FLEX_INTEREST_ENABLED=false
IBKR_FLEX_TOKEN=
# Flex Activity history uses its own query. Do not reuse the
# interest-validation query.
IBKR_FLEX_ACTIVITY_ENABLED=false
IBKR_FLEX_ACTIVITY_QUERY_ID=
IBKR_FLEX_ACTIVITY_EXPECTED_ACCOUNTS=
# Enable when the saved query uses an IBKR-managed rolling period (for example,
# Last 365 Calendar Days) and rejects fd/td request overrides.
IBKR_FLEX_ACTIVITY_USE_QUERY_PERIOD=false
IBKR_FLEX_INTEREST_QUERY_ID=
IBKR_FLEX_EXPECTED_ACCOUNT_ID=
IBKR_FLEX_BASE_URL=https://ndcdyn.interactivebrokers.com/AccountManagement/FlexWebService
IBKR_FLEX_TARGET_CASH_BUFFER_PCT=0
# IBKR_FLEX_DATA_DIR=data/ibkr-flex

# Daily IBKR debit-interest validation and graduated reserve policy
IBKR_INTEREST_VALIDATION_ENABLED=false
# off | observe | graduated
IBKR_INTEREST_GUARD_MODE=graduated
IBKR_INTEREST_VALIDATION_TIME_ZONE=America/New_York
IBKR_INTEREST_VALIDATION_POLL_MS=60000
# IBKR_INTEREST_VALIDATION_DATA_DIR=~/Library/Application Support/market-dashboard/ibkr-interest-validation-v1

IBKR_LIVE_SESSION_VERIFY_TIMEOUT_SEC=2.5
# Licensed server-only global bond feed.
# When absent, global sovereign rows use dated FRED/OECD observations.
TRADING_ECONOMICS_API_KEY=
# Durable, non-executable last-verified market observations.
# MARKET_QUOTE_REFERENCE_DATA_DIR=data/market-quotes-reference
BEA_API_KEY=
FRED_API_KEY=

# CME CVOL End-of-Day API (preferred true FXVL / G5 FX implied vol)
# Entitle an OAuth API ID for CVOL EOD via CME Market Data self-service or GAM.
# Without these credentials the USD card still goes live via Yahoo G5 1M realized-vol fallback.
CME_CVOL_API_ID=
CME_CVOL_API_PASSWORD=
# CME_CVOL_TOKEN_URL=https://auth.cmegroup.com/as/token.oauth2
# CME_CVOL_BASE_URL=https://markets.api.cmegroup.com/cvol-eod/v1
# CME_CVOL_APP_NAME=market-dashboard
# CME_CVOL_APP_VENDOR=timavn
# CME_CVOL_APP_VERSION=1.0.0

# Hermes worker orchestration (server-side; restart npm run server after changes)
HERMES_AGENT_RUNS_TABLE=HermesAgentRuns
HERMES_ALERTS_TABLE=HermesAlerts
HERMES_QUANT_ANALYST_FUNCTION=market-dashboard-hermes-worker-v2
HERMES_QUANT_DEVELOPER_FUNCTION=market-dashboard-hermes-worker-v2
HERMES_SECURITY_FUNCTION=market-dashboard-hermes-worker-v2
# Hermes Gmail ingestion. Gmail filter should apply label/folder "Hedgeye" to Hedgeye mail.
GMAIL_OAUTH_SECRET_NAME=hermes/gmail/oauth
HERMES_GMAIL_ACCOUNT=timsmithaviation@gmail.com
HERMES_GMAIL_QUERY=label:Hedgeye newer_than:365d
HERMES_GMAIL_INGESTOR_FUNCTION=market-dashboard-gmail-ingestor-v2
HERMES_GMAIL_SCHEDULE_ID=market-dashboard-gmail-v2-every-15m
GMAIL_HEARTBEAT_MAX_AGE_MINUTES=45
# Outbound-only local-to-AWS bridge. Partition controls permit operations
# telemetry to roll out before the verified-live portfolio partition. The
# legacy master flag remains a backward-compatible default for both.
HERMES_BRIDGE_ENABLED=false
HERMES_OPERATIONS_BRIDGE_ENABLED=false
HERMES_PORTFOLIO_BRIDGE_ENABLED=false
# The Analyst is the sole Hermes agent. Legacy workers remain read-only for
# historical inspection; shadow mode requires an explicit compatibility opt-in.
LEGACY_HERMES_MODE=read-only
REACT_APP_ANALYST_SHADOW_MODE=false
# UI-only session retention. Set to false for an immediate rollback to the
# previous mount/fetch behavior; no API, sidecar, or polling-service changes.
REACT_APP_DASHBOARD_SESSION_RETENTION=true
# Legacy GM launches are retired and rejected by the gateway.
ANALYST_GM_ENABLED=false
# ReviewRunV2 features roll out independently. Keep a review false until its
# isolated provider, coordinator, production build, and browser smoke pass.
ANALYST_PREDICTION_MARKETS_REVIEW_ENABLED=true
ANALYST_PORTFOLIO_REVIEW_V2_ENABLED=true
# One account-scoped live P&L subscription is shared across concurrent callers
# and fails closed after this verified-live upper bound (maximum: 5 seconds).
IBKR_PNL_WAIT_SEC=5
MARKET_DASHBOARD_API_BASE=http://127.0.0.1:3001
HERMES_INPUT_SNAPSHOT_TABLE=HermesInputSnapshots
SERVICE_HEARTBEAT_TABLE=MarketDashboardServiceHeartbeats
HERMES_BRIDGE_HOST_ID=tim-market-dashboard
HERMES_BRIDGE_INTERVAL_MS=60000
HERMES_BRIDGE_HEARTBEAT_MAX_AGE_MS=180000
HERMES_BRIDGE_REQUEST_TIMEOUT_MS=20000
HERMES_BRIDGE_MAX_INPUT_AGE_MS=180000
HERMES_BRIDGE_TTL_DAYS=30
# The deterministic readiness controller observes every allowlisted policy in
# shadow mode. Active mode dispatches only these exact comma-separated IDs.
READINESS_CONTROLLER_MODE=shadow
READINESS_CONTROLLER_ENABLED_ACTIONS=
READINESS_CONTROLLER_HEARTBEAT_MAX_AGE_MS=180000
# The old HERMES_RELIABILITY_* and HERMES_CONTROLLER_* names remain accepted
# only during the 30-day rollback window; READINESS_CONTROLLER_* takes precedence.
# Expensive operational readiness probes have a hard five-minute minimum.
SYSTEM_READINESS_CACHE_MS=300000
# AWS_REGION=us-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
